{
  "name": "projectstudio",
  "private": true,
  "version": "0.0.0-fase00",
  "description": "ProjectStudio Fase 00: contratos y spikes aislados",
  "packageManager": "pnpm@10.16.1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike:omp": "tsx scripts/run-omp-rpc-spike.ts",
    "spike:omp:real": "tsx scripts/run-omp-rpc-spike.ts --real",
    "spike:langgraph": "tsx scripts/run-langgraph-sqlite-spike.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "jiti": "2.6.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vitest": "4.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
