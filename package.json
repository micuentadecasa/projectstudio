{
  "name": "projectstudio",
  "private": true,
  "version": "0.0.0-fase04",
  "description": "ProjectStudio Fase 04: chat OMP visible",
  "packageManager": "pnpm@10.16.1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:desktop": "vite build --config apps/desktop/vite.config.ts && tsc -p apps/desktop/tsconfig.main.json",
    "build:all": "pnpm build && pnpm build:desktop",
    "desktop": "pnpm build:all && electron apps/desktop/dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:desktop": "tsc -p apps/desktop/tsconfig.main.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/e2e/desktop-smoke.ts",
    "test:f02": "vitest run tests/studio-graph.test.ts",
    "test:f04": "pnpm build:all && pnpm test:e2e",
    "test:e2e:real": "pnpm build:all && tsx tests/e2e/desktop-real-chat.ts",
    "spike:omp": "tsx scripts/run-omp-rpc-spike.ts",
    "spike:omp:real": "tsx scripts/run-omp-rpc-spike.ts --real",
    "spike:langgraph": "tsx scripts/run-langgraph-sqlite-spike.ts",
    "spike:studio-graph": "tsx scripts/run-studio-graph-spike.ts",
    "spike:omp-adapter": "tsx scripts/run-omp-adapter-spike.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "electron": "45.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "jiti": "2.6.1",
    "playwright": "1.64.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.1.12",
    "vitest": "4.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
